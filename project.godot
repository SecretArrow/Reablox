; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Reablox"
config/description="Sandbox 3D gratis bergaya blocky: bangun, main, dan berbagi dunia. Offline & multiplayer lokal. 100% gratis tanpa iklan."
config/version="0.6.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.4", "Mobile")
boot_splash/bg_color=Color(0.07, 0.08, 0.12, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/core/game_config.gd"
GameEvents="*res://scripts/core/game_events.gd"
Settings="*res://scripts/core/settings_mgr.gd"
Locale="*res://scripts/core/locale_manager.gd"
Audio="*res://scripts/core/audio_mgr.gd"
Saves="*res://scripts/core/save_mgr.gd"
GameState="*res://scripts/core/game_state.gd"
SceneLoader="*res://scripts/core/scene_loader.gd"
Net="*res://scripts/multiplayer/net_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="parts"
3d_physics/layer_4="npc"
3d_physics/layer_5="water"
3d_physics/layer_6="pickup"
3d_physics/layer_7="projectile"

[physics]

; Skala dunia baru: 1 unit = 1 stud (paritas Roblox).
3d/default_gravity=196.2

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Perangkat/emulator tanpa Vulkan otomatis fallback ke OpenGL (Compatibility)
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=2048
